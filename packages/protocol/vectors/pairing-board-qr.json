      "name": "a siren's display",
      "text": "hsn://pair/1?c=PSXTK1B3&d=3c71bf9a4f2a",
      "qr": {
        "code": "PSXTK1B3",
        "chipId": "3c71bf9a4f2a"
      }
    },
    {
      "name": "the chip id first",
      "text": "hsn://pair/1?d=3c71bf9a4f2a&c=PSXTK1B3",
      "qr": {
        "code": "PSXTK1B3",
        "chipId": "3c71bf9a4f2a"
      }
    },
    {
