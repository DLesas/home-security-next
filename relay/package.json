  },
  "dependencies": {
    "@hsn/deployment": "workspace:*",
    "@hsn/protocol": "workspace:*",
    "drizzle-orm": "0.45.4",
    "neverthrow": "8.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
