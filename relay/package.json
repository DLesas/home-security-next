{
  "name": "@hsn/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The relay: hub and phone links, presence and hub-unreachable alerts, push to Apple and Google, signed releases (docs/m4-design.md section 3).",
  "scripts": {
