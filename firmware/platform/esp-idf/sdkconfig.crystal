# Added after sdkconfig.defaults on a board with a 32.768 kHz crystal across GPIO15 and GPIO16
# (dev-board-choice.md, "Other parts"), for spike S8's run with the crystal:
#   idf.py ... -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.crystal" build
# Calibration over 3,000 cycles is ESP-IDF's default for the crystal.
CONFIG_RTC_CLK_SRC_INT_RC=n
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_RTC_CLK_CAL_CYCLES=3000
