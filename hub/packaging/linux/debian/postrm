#!/bin/sh
# The .deb's postrm: uninstalling keeps the data folder (section 9); `apt purge` removes it, the
# program's versions and the hub's account.
set -eu
case "$1" in
  remove)
    systemctl daemon-reload || true
    ;;
  purge)
    systemctl daemon-reload || true
    rm -rf /opt/hsn-hub /var/lib/hsn-hub
    if getent passwd hsn >/dev/null; then deluser --system hsn || true; fi
    ;;
esac
exit 0
