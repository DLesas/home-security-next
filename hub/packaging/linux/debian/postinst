#!/bin/sh
# The .deb's postinst (m2-design.md section 9, Linux, and "The privilege boundary"), as root: the
# hub's account, each hub tree's top folder (never its contents), the packaged versions, the
# services, the firewall, the `installed` marker, and on a fresh install the setup page through
# the package's own `hsn`. It never runs the hub's program, never recurses into a hub tree and
# never chooses a version: the launcher does, as the hub's account, at its next start.
set -eu
PKG=/usr/lib/hsn-hub
DATA=/var/lib/hsn-hub
PROGRAM=/var/lib/hsn-hub-program
VERSION=$(cat "$PKG/version")
[ "$1" = "configure" ] || exit 0

# Fresh means this package was never installed here: its root-owned marker, not the hub's files.
fresh=yes
[ -e "$PKG/installed" ] && fresh=no

if ! getent passwd hsn >/dev/null; then
  adduser --system --group --home "$DATA" --no-create-home --shell /usr/sbin/nologin hsn
fi
# The USB port: dialout as the account's supplementary group only; the data folder is hsn:hsn.
getent group dialout >/dev/null && usermod -a -G dialout hsn

"$PKG/prepare-hub-folder.sh" "$DATA" hsn hsn
"$PKG/prepare-hub-folder.sh" "$PROGRAM" hsn hsn

# The version this package replaced, kept aside by preinst, beside the new one; then at most two.
if [ -d "$PKG/kept" ]; then
  for kept in "$PKG"/kept/*; do
    [ -d "$kept" ] || continue
    name=$(basename "$kept")
    [ "$name" = "$VERSION" ] || { rm -rf "$PKG/packaged/$name"; mv "$kept" "$PKG/packaged/$name"; }
  done
  rm -rf "$PKG/kept"
fi
"$PKG/prune-packaged.sh" "$PKG/packaged" "$VERSION"

touch "$PKG/installed"
chmod 0644 "$PKG/installed"

systemctl daemon-reload
systemctl enable hsn-hub.service hsn-hub-inhibit.service
systemctl restart hsn-hub.service

# The two LAN ports and mDNS, when ufw is on (section 9, "Firewall").
if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
  ufw allow 8443/tcp comment "hsn-hub devices" >/dev/null
  ufw allow 8444/tcp comment "hsn-hub apps" >/dev/null
  ufw allow 5353/udp comment "hsn-hub mDNS" >/dev/null
fi

[ "$fresh" = yes ] || exit 0
# A silent install (no person: no terminal, or a non-interactive front end) makes no token.
if [ "${DEBIAN_FRONTEND:-}" = noninteractive ] || ! [ -t 1 ]; then
  echo "hsn-hub: installed. Run \`sudo hsn open\` to link the first browser or phone."
  exit 0
fi
# The person who ran the installer: their own desktop session, unelevated (D62, HB19); with none,
# `hsn open` prints the first linking code, the address and the fingerprint.
user=${SUDO_USER:-}
if [ -z "$user" ] || [ "$user" = root ] || [ ! -S "/run/user/$(id -u "$user")/bus" ]; then user=""; fi
if ! "$PKG/open-setup-page.sh" /usr/bin/hsn "$user"; then
  echo "hsn-hub: installed, but the first code could not be shown: run \`sudo hsn open\`." >&2
fi
exit 0
