<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hub's launchd daemon (m2-design.md section 9, macOS): run at load with nobody logged in, as
  its own user, and started again on any exit but a clean stop (KeepAlive, SuccessfulExit false).
  The launcher starts and restarts the hub; the hub keeps the computer awake (caffeinate, HB28).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hsn.hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/hsn-hub/hsn-launcher</string>
    <string>--prefix</string>
    <string>/usr/local/hsn-hub</string>
    <string>--data</string>
    <string>/Library/Application Support/HSN Hub</string>
  </array>
  <key>UserName</key>
  <string>_hsnhub</string>
  <key>GroupName</key>
  <string>_hsnhub</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/HSN Hub/hub.log</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/HSN Hub/hub.log</string>
</dict>
</plist>
