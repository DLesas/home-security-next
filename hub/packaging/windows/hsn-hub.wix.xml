<!--
  The .msi (m2-design.md section 9, Windows), for WiX Toolset 5 (`wix build`), built by
  build-msi.ps1 with -d Version=<v> -d ProgramDir=<build-program's out> -d LauncherDir=<staged>.
  Unsigned: SmartScreen warns on first run (section 12). Per machine, elevated.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="HSN Hub" Manufacturer="HSN" Version="$(Version)" Scope="perMachine"
           UpgradeCode="6B2B8A2E-4C0F-4F7B-9B57-5E1C3A9D2F41">
    <MajorUpgrade DowngradeErrorMessage="A newer HSN Hub is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="PREFIX" Name="HSN Hub">
        <Directory Id="VERSIONS" Name="versions">
          <Directory Id="VERSIONDIR" Name="$(Version)" />
        </Directory>
      </Directory>
      <Directory Id="LAUNCHERDIR" Name="HSN Hub Launcher">
        <Component Id="Launcher" Guid="0E9D3C7A-8E0B-4E35-A0E3-2B6F1C4D5A71">
          <File Source="$(LauncherDir)\hsn-launcher.exe" />
          <File Source="$(LauncherDir)\HSNHub.exe" />
          <File Source="$(LauncherDir)\HSNHub.xml" />
          <File Source="$(LauncherDir)\WinSW-LICENSE.txt" />
          <File Source="$(LauncherDir)\hsn.cmd" />
          <File Source="$(LauncherDir)\install-service.ps1" />
          <File Source="$(LauncherDir)\uninstall-service.ps1" />
          <Environment Id="PathToHsn" Name="PATH" Value="[LAUNCHERDIR]" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Hub">
      <ComponentRef Id="Launcher" />
      <Files Include="$(ProgramDir)\versions\$(Version)\**" Directory="VERSIONDIR" />
    </Feature>

    <!-- An upgrade: the running launcher and hub stopped before their files change. -->
    <CustomAction Id="StopService" Directory="TARGETDIR" Execute="deferred" Impersonate="no"
                  Return="ignore" ExeCommand="sc.exe stop HSNHub" />
    <CustomAction Id="InstallService" Directory="LAUNCHERDIR" Execute="deferred" Impersonate="no"
                  Return="check"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[LAUNCHERDIR]install-service.ps1&quot; -Version $(Version) -UserSid &quot;[UserSID]&quot; -LocalAppData &quot;[LocalAppDataFolder]&quot;" />
    <CustomAction Id="UninstallService" Directory="LAUNCHERDIR" Execute="deferred" Impersonate="no"
                  Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[LAUNCHERDIR]uninstall-service.ps1&quot;" />
    <!-- The Finish dialog's "Open the setup page", ticked: the page's path, from the installer's own
         interface, as the installing person, unelevated (section 9). -->
    <ui:WixUI Id="WixUI_Minimal" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the setup page" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[LocalAppDataFolder]HSN Hub\setup.html" />
    <CustomAction Id="OpenSetupPage" DllEntry="WixShellExec" Impersonate="yes"
                  BinaryRef="Wix4UtilCA_X64" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenSetupPage"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <InstallExecuteSequence>
      <Custom Action="StopService" Before="InstallFiles" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="UninstallService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InstallService" Before="InstallFinalize" Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
